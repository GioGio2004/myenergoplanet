# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public URL phones use to reach this app (LAN IP, tunnel or deploy URL).
# Falls back to the current browser origin when empty.
NEXT_PUBLIC_APP_URL=

# Optional TURN server for phones on mobile data or strict networks (WebRTC).
# Same Wi-Fi as the host screen works without it.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
